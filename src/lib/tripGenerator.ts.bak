"use server"
import { prisma } from "@/lib/prisma"
import { PRICE_RANGES } from "@/types"

export async function generateTrip(data: any) {
  const { fromCity, toCity, startDate, days, adultCount, childCount, budget, preferences, roomType, extraRequirements } = data
  const now = new Date().toISOString()
  const hotels = await searchHotels(toCity, roomType, budget, days, adultCount + childCount)
  const transports = await searchTransport(fromCity, toCity, budget, days, startDate)
  const itineraryDays = await buildItinerary(toCity, days, preferences, extraRequirements)
  const xhsNotes = await fetchXhsNotes(toCity, preferences, days)
  const trip = await prisma.trip.create({
    data: {
      fromCity, toCity, startDate, days, adultCount, childCount, budget,
      preferences: JSON.stringify(preferences),
      roomType, extraRequirements, status: "generated", createdAt: now, updatedAt: now,
      hotels: { create: hotels.map((h) => ({ name: h.name, price: h.price, rating: h.rating, address: h.address, source: h.source, sourceLabel: h.sourceLabel, url: h.url, tag: h.tag, createdAt: now })) },
      transports: { create: transports.map((t) => ({ origin: t.origin, destination: t.destination, method: t.method, price: t.price, duration: t.duration, source: t.source, sourceLabel: t.sourceLabel, url: t.url, details: t.details, routeNumber: t.routeNumber, departureTime: t.departureTime, arrivalTime: t.arrivalTime, isSample: t.isSample, isRecommended: (t as any).isRecommended || false, createdAt: now })) },
      itineraryDays: { create: itineraryDays.map((d) => ({ dayIndex: d.dayIndex, title: d.title, activities: d.activities, createdAt: now })) },
      xhsNotes: { create: xhsNotes.map((n) => ({ title: n.title, excerpt: n.excert, author: n.author, likes: n.likes, sourceUrl: n.sourceUrl, tags: n.tags, createdAt: now })) },
    },
    include: { hotels: true, transports: true, itineraryDays: { orderBy: { dayIndex: "asc" } }, xhsNotes: true },
  })
  const hotelPriceRange = (PRICE_RANGES as any)[roomType] || [300, 600]
  const avgHotelPrice = (hotelPriceRange[0] + hotelPriceRange[1]) / 2
  const totalHotelCost = avgHotelPrice * (days - 1)
  const totalTransportCost = transports.reduce((sum, t) => sum + t.price, 0)
  const totalEstimatedCost = totalHotelCost + totalTransportCost + budget * 0.15
  return { trip, totalEstimatedCost }
}

