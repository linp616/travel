  const budgetPerNight = budget ? budget / (days || 3) : 400
  const priceRatio = budgetPerNight / 500
  return hotels.map((h: any) => ({
    ...h,
    price: Math.round((h.price1 || h.price2 || 400) * Math.max(0.7, Math.min(1.3, priceRatio))),
    url: "https://www.ctrip.com/hotel/" + encodeURIComponent(city),
  }))
}async function buildItinerary(city: any, days: any, preferences: any, extraReqs: any, budget?: number) {\n  const transportBudget = budget ? budget * 0.25 : 500;\n  const hotelBudget = budget ? budget * 0.25 : 800;\n  const activityBudget = budget ? (budget - transportBudget - hotelBudget) / Math.max(1, days - 1) : 300;
  const attractionMap = {
    "文化": ["博物馆", "历史遗迹", "古城墙", "文化街"],
    "自然": ["国家森林公园", "风景区", "自然保护区", "地质公园"],
    "美食": ["特色街", "美食广场", "夜市", "老字号餐厅"],
    "购物": ["购物中心", "商业街", "本地市场"],
    "亲子": ["游乐园", "动物园", "科技馆", "儿童公园"],
    "摄影": ["地标建筑", "自然景观", "老街", "观景台"],
    "休闲": ["温泉SPA", "咖啡街", "湿地公园", "体育中心"],
  }
  const prefs = preferences.slice(0, 4)
  const result = []
  for (let i = 1; i <= days; i++) {
    const activities = []
    const times = ["上午", "午餐时间", "下午", "晚上"]
    for (let j = 0; j < Math.min(prefs.length, 3); j++) {
      const spots = [attractionMap as any][prefs[j]] || ["景点"]
      activities.push({ name: spots[j % spots.length], duration: "2-3小时", timeSlot: times[j] })
    }
    if (extraReqs) activities.push({ name: extraReqs.substring(0, 15) + "...", duration: "1-2小时", timeSlot: "晚上" })
    result.push({ dayIndex: i, title: "探索" + city + "第" + i + "天", activities: JSON.stringify(activities) })
  }
  return result
}

async function fetchXhsNotes(city: any, preferences: any, days: any) {
  const noteTemplates = [
    { title: city + "必去景点！本地人推荐", excert: "第一次来" + city + "，这些地方...人均约" + Math.round(300 + Math.random() * 400) + "元/人", author: "旅行达人" + Math.floor(Math.random() * 99), likes: Math.floor(Math.random() * 5000) + 500 },
    { title: city + "美食攻略|这家店值得排2小时队", excert: "尝试了" + city + "多家餐厅，这家排名第一...人均约" + Math.round(50 + Math.random() * 150) + "元", author: "美食爱好者" + Math.floor(Math.random() * 99), likes: Math.floor(Math.random() * 3000) + 300 },
    { title: city + "3天2晚旅游攻略|详细避雷指南", excert: "去了" + city + "玩3天，做了详细攻略...总花费约" + Math.round(days * (200 + Math.random() * 300)) + "元/人", author: "背包客" + Math.floor(Math.random() * 200), likes: Math.floor(Math.random() * 8000) + 1000 },
    { title: "避雷帖！来" + city + "前必看", excert: "在" + city + "踩了很多坑，请大家避雷...建议节省预算", author: "本地旅行者" + Math.floor(Math.random() * 99), likes: Math.floor(Math.random() * 6000) + 800 },
    { title: city + "酒店推荐|这家酒店性价比超高", excert: "住了" + city + "多家酒店，这些最推荐...均价约" + Math.round(200 + Math.random() * 300) + "元/晚", author: "酒店评测师" + Math.floor(Math.random() * 100), likes: Math.floor(Math.random() * 4000) + 500 },
    { title: city + "小众玩法|避开人群的secret base", excert: "当地人带路小众景点...不拥挤且便宜", author: "探索者" + Math.floor(Math.random() * 99), likes: Math.floor(Math.random() * 2000) + 200 },
  ]
  const prefsStr = preferences.join("-")
  const tags = ["#" + city, "#拍照打卡", "#旅行攻略", "#" + prefsStr, "#" + prefsStr, "#" + prefsStr]
  return noteTemplates.slice(0, Math.min(12, 6 + preferences.length)).map((n) => ({
    ...n,
    sourceUrl: "https://www.xiaohongshu.com/search_result?keyword=" + encodeURIComponent(city + "旅游攻略"),
    tags: JSON.stringify(tags)
  }))
}

const TRANSPORT_SAMPLES = [
  { method: "高铁", routeNumber: "G1234", departureTime: "08:00", arrivalTime: "12:00", duration: 240, price: 550, sourceLabel: "12306", details: "示例 · 二等座", isSample: true },
  { method: "高铁", routeNumber: "G5678", departureTime: "10:30", arrivalTime: "14:15", duration: 225, price: 580, sourceLabel: "携程", details: "示例 · 一等座", isSample: true },
  { method: "飞机", routeNumber: "CA1832", departureTime: "09:00", arrivalTime: "11:00", duration: 120, price: 800, sourceLabel: "携程", details: "示例 · 经济舱含机建燃油", isSample: true },
  { method: "飞机", routeNumber: "MU5136", departureTime: "14:00", arrivalTime: "16:10", duration: 130, price: 720, sourceLabel: "去哪儿", details: "示例 · 经济舱含机建燃油", isSample: true },
  { method: "火车", routeNumber: "K234", departureTime: "22:00", arrivalTime: "06:00", duration: 480, price: 320, sourceLabel: "12306", details: "示例 · 硬卧", isSample: true },
  { method: "大巴", routeNumber: "长途专线", departureTime: "07:00", arrivalTime: "13:00", duration: 360, price: 180, sourceLabel: "携程", details: "示例 · 舒适大巴", isSample: true },
]

function buildBookingUrl(sourceLabel: any, from: any, to: any, date: any) {
  const d = date || ""
  const q = String.fromCharCode(38)
  const urls = {
    "12306": "https://kyfw.12306.cn/otn/leftTicket/init?linktype=dc" + q + "fs=" + encodeURIComponent(from) + "!" + encodeURIComponent(to) + q + "todates=" + d + q + "bid=0" + q + "oid=0",
    "携程": "https://train.ctrip.com/trainbooking/Booking/Search?from=" + encodeURIComponent(from) + q + "to=" + encodeURIComponent(to) + q + "day=" + d,
    "飞猪": "https://fliggy.com/train/search?departure=" + encodeURIComponent(from) + q + "destination=" + encodeURIComponent(to),
    "去哪儿": "https://train.qunar.com/booking/search?from=" + encodeURIComponent(from) + q + "to=" + encodeURIComponent(to),
  }
  return (urls as any)[sourceLabel] || urls["12306"]
}

function calcTransportScore(t: any) {
  const priceFactor = (t.price / 100) * 0.5
  const durationFactor = (t.duration / 60) * 0.3
  const typeCoeff = ({"高铁": 90, "飞机": 80, "火车": 70, "大巴": 70} as any)[t.method] || 70
  const typeFactor = typeCoeff * 0.2
  return priceFactor + durationFactor + typeFactor
}

async function searchTransport(from: any, to: any, budget: any, days: any, startDate: any) {
  const priceRatio = budget / 5000
  const results = TRANSPORT_SAMPLES.map((s: any) => {
    const price = Math.round(s.price * Math.max(0.7, Math.min(1.5, priceRatio)))
    const score = calcTransportScore({ ...s, price })
    const url = buildBookingUrl(s.sourceLabel, from, to, startDate)
    return { origin: from, destination: to, method: s.method, price, duration: s.duration, source: s.sourceLabel, sourceLabel: s.sourceLabel, details: s.details, url, score, routeNumber: s.routeNumber, departureTime: s.departureTime, arrivalTime: s.arrivalTime, isSample: s.isSample }
  })
  results.sort((a, b) => a.score - b.score)
  if (results.length > 0) (results[0] as any).isRecommended = true
  return results.slice(0, 3)
}