      { name: "成都如家酒店", price1: 188, price2: 238, address: "成都市锦江区红星路", rating: 4.1, source: "qunar", sourceLabel: "去哪儿", tag: "第二档 · 舒适型" },
      { name: "成都世纪城天堂洲际大饭店", price1: 980, price2: 1180, address: "成都市高新区天府大道", rating: 4.8, source: "ctrip", sourceLabel: "携程", tag: "第三档 · 豪华型" },
